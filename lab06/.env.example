AWS_REGION=us-east-2
AZ_A=us-east-2a
AZ_B=us-east-2b
AMI_ID=replace-with-amazon-linux-2023-ami
INSTANCE_TYPE=t3.micro
KEY_NAME=replace-with-your-key-pair-name
APP_SECURITY_GROUP_ID=replace-with-your-app-security-group-id

WEATHER_ROLE_NAME=itmo-444-544-weather-role
WEATHER_PROFILE_NAME=itmo-444-544-weather-profile
WEATHER_LT_NAME=itmo-444-544-weather-lt
WEATHER_TG_NAME=itmo-444-544-weather-tg
WEATHER_ASG_NAME=itmo-444-544-weather-asg
WEATHER_LISTENER_PORT=8080

ADVISOR_ROLE_NAME=itmo-444-544-advisor-role
ADVISOR_PROFILE_NAME=itmo-444-544-advisor-profile
ADVISOR_LT_NAME=itmo-444-544-advisor-lt
ADVISOR_TG_NAME=itmo-444-544-advisor-tg
ADVISOR_ASG_NAME=itmo-444-544-advisor-asg
ADVISOR_LISTENER_PORT=8081

ALB_NAME=itmo-444-544-weather-alb
ALB_SG_NAME=itmo-444-544-weather-alb-sg
APP_PORT=3000
RECOVERY_SLO_SECONDS=300

DB_INSTANCE_ID=itmo-444-544-weather-db
DB_INSTANCE_CLASS=db.t4g.micro
DB_ALLOCATED_STORAGE=20
DB_PORT=5432
DB_NAME=weather
DB_USER=weatherapp
DB_SG_NAME=itmo-444-544-weather-db-sg
DB_SUBNET_GROUP_NAME=itmo-444-544-weather-db-subnets
DB_PASSWORD_PARAM=/itmo-444-544/db-password
CACHE_SECONDS=600

GEMINI_PARAM_NAME=/itmo-444-544/gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
KEY_CACHE_SECONDS=60
CONTACT_EMAIL=your-email@example.com